# ============================================================
#  MGCV26 Setup Observer — template
#  Copy to .env and fill in real values. Never commit .env.
# ============================================================

# ---- Telegram ----
TELEGRAM_BOT_TOKEN=your-botfather-token-here
TELEGRAM_CHAT_ID=your-numeric-chat-id-here

# ---- Tradovate (LIVE) ----
# cid + sec: Tradovate > Application Settings > API Access
TRADOVATE_ENV=live
TRADOVATE_USERNAME=
TRADOVATE_PASSWORD=
TRADOVATE_APP_ID=MGCV26Observer
TRADOVATE_APP_VERSION=1.0
TRADOVATE_CID=
TRADOVATE_SEC=

# ---- Instrument ----
SYMBOL=MNQU6

# ---- Behaviour ----
MAX_ALERTS_PER_DAY=2
