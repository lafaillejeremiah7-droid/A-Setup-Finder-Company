# Server
PORT=3000
POLL_MS=15000
MAX_DATA_AGE_MS=60000

# Set DEMO_MODE=false when using a real source.
DEMO_MODE=true

# Live GEX endpoint. It must return the JSON shape documented in README.md.
GEX_SOURCE_URL=

# Optional authentication for the live source.
GEX_API_KEY=
GEX_AUTH_HEADER=Authorization
GEX_AUTH_PREFIX=Bearer 
