# Server
PORT=3000

# Rate-conscious defaults for CME futures. Lower these only if your FlashAlpha
# plan/request budget supports it and you intentionally run fewer hours.
POLL_MS=60000
MAX_DATA_AGE_MS=180000

# Provider selection: flashalpha | generic
GEX_PROVIDER=flashalpha

# Keep true to run the UI without an API key.
DEMO_MODE=true

# FlashAlpha live CME futures GEX
# Docs use NQ=F for E-mini Nasdaq-100 futures. The resulting strike levels use
# the same Nasdaq-100 index-point scale as MNQ, so they plot directly on MNQ.
FLASHALPHA_API_KEY=
FLASHALPHA_BASE_URL=https://lab.flashalpha.com
FLASHALPHA_SYMBOL=NQ=F
FLASHALPHA_POLARITY=convention
FLASHALPHA_EXPIRY=

# Per-strike GEX is only needed for wall $GEX + concentration strength. Cache it
# longer than the live levels endpoint to conserve request budget.
FLASHALPHA_GEX_REFRESH_MS=300000

# Legacy generic-provider settings (used only when GEX_PROVIDER=generic)
GEX_SOURCE_URL=
GEX_API_KEY=
GEX_AUTH_HEADER=Authorization
GEX_AUTH_PREFIX=Bearer 
